PORT=3001
# 前端访问地址（用于生成邀请注册链接）
# 开发模式（前后端分离）：http://localhost:3000
# 生产模式（前端由后端托管）：http://localhost:3001
FRONTEND_URL=http://localhost:3001
JWT_SECRET=change_this_to_a_long_random_string
DATA_DIR=./data
ADMIN_INIT_PASSWORD=
# Unia-BiliCookie 服务地址，留空则使用本地 cookies.json
COOKIE_MANAGER_URL=http://localhost:3100
# 指定用于房管操作的 B 站账号 UID（必须配置，否则禁言等操作无权限）
BILI_COOKIE_UID=
# 直播间房间号（启动时自动连接）
ROOM_ID=
# 定时禁言到期检查间隔（毫秒），默认 60000
BAN_AUTO_CHECK_INTERVAL_MS=
# 直播结束后检查「本场」禁言的延迟（毫秒），默认 30000
BAN_LIVE_END_CHECK_DELAY_MS=
